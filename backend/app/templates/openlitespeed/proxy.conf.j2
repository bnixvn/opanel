# OPanel managed vhost: {{ domain }}
# App type: proxy
# OPANEL PROXY TARGET: {{ proxy_url }}
# OPANEL PROXY HOST: {{ 'visitor' if proxy_preserve_host else 'upstream' }}
# Generated by OPanel — do not edit manually.

docRoot                   {{ root_path }}/{{ document_root }}

vhDomain                  {{ domain }}
{% for alias in aliases %}
vhAliases                 {{ alias }}
{% endfor %}
{% for redirect in redirects %}
vhAliases                 {{ redirect.host }}
{% endfor %}

enableGzip                1
enableBr                  1

errorlog {{ error_log }} {
    useServer             0
    logLevel              WARN
    rollingSize           10M
}

accesslog {{ access_log }} {
    useServer             0
    rollingSize           100M
    keepDays              30
    logReferer            1
    logUserAgent          1
}

{% if has_ssl %}
vhssl {
    keyFile               {{ ssl_key_path }}
    certFile              {{ ssl_cert_path }}
{% if ssl_ca_path %}
    caBundlePath          {{ ssl_ca_path }}
{% endif %}
    certChain             1
}
{% endif %}

# The upstream: every request but the certificate challenge goes to it.
extprocessor {{ proxy_app }} {
    type                  proxy
    address               {{ proxy_address }}
    maxConns              100
    pcKeepAliveTimeout    60
    initTimeout           60
    retryTimeout          0
    respBuffer            0
}

{# One rewrite block only: LiteSpeed does not merge sibling blocks. #}
rewrite {
    enable                1
    rewriteRules          <<<END_RULES
{% if ssl_enabled %}RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
{% endif %}{% for redirect in redirects %}RewriteCond %{HTTP_HOST} ^(www\.)?{{ redirect.source }}$ [NC]
RewriteRule ^ {{ redirect.target }}%{REQUEST_URI} [R={{ redirect.code|default(301) }},L]
{% endfor %}{% for line in custom_rewrites %}{{ line }}
{% endfor %}RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^/?(.*)$ http://{{ proxy_app }}{{ proxy_path }}/$1 [P{% if not proxy_preserve_host %},E=Proxy-Host:{{ proxy_host }}{% endif %},L]
END_RULES
}

{% if waf_enabled %}
# OPANEL WAF BEGIN
module mod_security {
    modsecurity           on
    modsecurity_rules_file  {{ waf_rules_file }}
}
# OPANEL WAF END
{% endif %}

context / {
    type                  null
    location              {{ root_path }}/{{ document_root }}
    allowOverride         0
    addDefaultCharset     off

    rewrite {
        enable              1
        inherit             1
    }
    extraHeaders <<<END_HEADERS
{% for line in header_lines %}{{ line }}
{% endfor %}END_HEADERS
}

context /.well-known/acme-challenge/ {
    type                  static
    location              {{ acme_webroot }}/.well-known/acme-challenge/
    allowBrowse           1
    addDefaultCharset     off
}
{% if proxy_ws_address %}

# WebSocket upgrades, straight to the upstream.
websocket / {
    address               {{ proxy_ws_address }}
}
{% endif %}
